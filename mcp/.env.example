# Base URL of the panel, no trailing slash.
PANEL_URL=https://panel.example.com

# Application API key (admin), created under Admin -> API. Starts with ptla_.
# Leave unset to skip registering the panel_admin_* tools.
PANEL_APPLICATION_KEY=

# Client API key, created by a user under Account -> API Credentials. Starts with ptlc_.
# Leave unset to skip registering the panel_client_* tools.
PANEL_CLIENT_KEY=

# Set to 1 to only register read-only (GET) tools. Any other value, or unset, registers everything
# the configured keys allow.
PANEL_MCP_READ_ONLY=
