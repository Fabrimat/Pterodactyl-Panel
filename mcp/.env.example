# Base URL of the panel, no trailing slash.
PANEL_URL=https://panel.example.com

# Application API key (admin), created under Admin -> API. Starts with ptla_.
# Leave unset to skip registering the panel_admin_* tools.
PANEL_APPLICATION_KEY=

# Client API key, created by a user under Account -> API Credentials. Starts with ptlc_.
# Leave unset to skip registering the panel_client_* tools.
PANEL_CLIENT_KEY=

# Set to 1 to only register read-only (GET) tools. Any other value, or unset, registers everything
# the configured keys allow.
PANEL_MCP_READ_ONLY=

# --- Streamable HTTP transport only (npm run start:http). Not used by the stdio server above. ---

# Port and host the HTTP transport listens on.
PANEL_MCP_HTTP_PORT=8089
PANEL_MCP_HTTP_HOST=127.0.0.1

# Externally reachable URL of this server's /mcp endpoint, e.g. https://mcp.example.com/mcp.
# Defaults to http://<host>:<port>/mcp, which only works for local testing - set this explicitly
# for any deployment reachable behind a reverse proxy or a different host name.
PANEL_MCP_PUBLIC_URL=

# Milliseconds of inactivity before an idle session is torn down and its bearer token
# discarded. Defaults to 1800000 (30 minutes).
PANEL_MCP_HTTP_SESSION_IDLE_MS=
